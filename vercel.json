{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "klarelle.store"
        }
      ],
      "destination": "https://www.klarelle.store/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "klarelle.store"
        }
      ],
      "destination": "https://www.klarelle.store/:path*",
      "permanent": true
    },
    {
      "source": "/returns",
      "destination": "/page/returns",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/page/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/page/terms-and-conditions",
      "permanent": true
    },
    {
      "source": "/category/coming-soon",
      "destination": "/category/new-in",
      "permanent": true
    },
    {
      "source": "/category/dinner-wear",
      "destination": "/category/dinner",
      "permanent": true
    },
    {
      "source": "/category/party-wear",
      "destination": "/category/celebration",
      "permanent": true
    },
    {
      "source": "/category/maxi-dresses",
      "destination": "/category/evening",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/gtag/js",
      "destination": "https://www.googletagmanager.com/gtag/js"
    },
    {
      "source": "/gtag/destination",
      "destination": "https://www.googletagmanager.com/gtag/destination"
    },
    {
      "source": "/g/collect",
      "destination": "https://www.google-analytics.com/g/collect"
    },
    {
      "source": "/",
      "destination": "/api/product-share?__path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/product-share?__path=/:path*"
    }
  ]
}
